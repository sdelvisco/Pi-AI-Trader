# =============================================================================
# Alpaca API Credentials Template
# =============================================================================
# Copy this file to:
#   config/alpaca_credentials.json  (for application use)
#   OR
#   /etc/tradingpi/alpaca.env       (for systemd EnvironmentFile use)
#
# SECURITY REQUIREMENTS:
#   - NEVER commit the completed credentials file to git
#   - config/alpaca_credentials.json is listed in .gitignore
#   - Set file permissions to 600 (owner read/write only):
#       chmod 600 config/alpaca_credentials.json
#   - If using as systemd EnvironmentFile, also chmod 600 the env file
#
# To obtain your Alpaca API keys:
#   1. Log in to https://app.alpaca.markets
#   2. Navigate to API Keys (Paper or Live trading section)
#   3. Generate a new key pair
#   4. Copy the Key ID and Secret Key immediately — the secret is only shown once
#
# Paper vs Live trading:
#   - Paper trading uses virtual money for testing strategies
#   - Paper API endpoint: https://paper-api.alpaca.markets
#   - Live API endpoint:  https://api.alpaca.markets
#   - Start with paper trading until you have validated your strategy
# =============================================================================

# Your Alpaca API Key ID (looks like: PKXXXXXXXXXXXXXXXXXXXX)
ALPACA_KEY_ID=YOUR_ALPACA_KEY_ID_HERE

# Your Alpaca Secret Key (shown only once at generation — store it safely)
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY_HERE

# Set to "true" for paper trading (virtual money), "false" for live money.
# STRONGLY RECOMMENDED: Keep as "true" until your strategy is thoroughly
# backtested and validated on paper trading.
ALPACA_PAPER_TRADING=true

# Alpaca API base URL — changes based on paper vs live mode.
# Paper:  https://paper-api.alpaca.markets
# Live:   https://api.alpaca.markets
# Leave blank to let the SDK determine this from ALPACA_PAPER_TRADING.
ALPACA_BASE_URL=

# Alpaca data API URL (same for both paper and live)
ALPACA_DATA_URL=https://data.alpaca.markets
