# =============================================================================
# Azure AI Foundry LLM Credentials Template
# =============================================================================
# Copy this file to:
#   /etc/tradingpi/azure.env       (for systemd EnvironmentFile use)
#
# This follows the exact same pattern as config/alpaca_credentials.template /
# /etc/tradingpi/alpaca.env (see that file and services/lean-trader.service's
# header comment) — AzureLlmClient reads these three variables directly from
# the process environment via Environment.GetEnvironmentVariable, so however
# they get into the process environment (systemd EnvironmentFile on the Pi,
# or `set -a; source ...; set +a` in a local dev shell) is fine.
#
# SECURITY REQUIREMENTS:
#   - NEVER commit the completed credentials file to git
#   - Set file permissions to 600 (owner read/write only):
#       sudo chmod 600 /etc/tradingpi/azure.env
#   - If using as systemd EnvironmentFile, also:
#       sudo chown root:root /etc/tradingpi/azure.env
# =============================================================================

# Base URL of your Azure AI Foundry resource, e.g.:
#   https://<your-resource-name>.services.ai.azure.com
# AzureLlmClient appends "/openai/v1/chat/completions" itself — do not
# include a trailing path here.
AZURE_LLM_ENDPOINT=YOUR_AZURE_AI_FOUNDRY_ENDPOINT_HERE

# API key for your Azure AI Foundry resource/deployment.
AZURE_LLM_API_KEY=YOUR_AZURE_LLM_API_KEY_HERE

# The deployment (model) name to send as the "model" field in each request,
# e.g.: Llama-4-Scout-17B-16E-Instruct
AZURE_LLM_DEPLOYMENT_NAME=YOUR_AZURE_LLM_DEPLOYMENT_NAME_HERE
