# =============================================================================
# lean-web.service — Flask Web Interface systemd Unit
# =============================================================================
# Manages the Flask-SocketIO web interface for the Pi-AI-Trader dashboard,
# providing:
#   - Live trading status and position overview
#   - Strategy performance metrics and charts
#   - Manual trade controls (pause, resume, emergency stop)
#   - Log viewer and system health indicators
#
# The web interface binds ONLY to the local network interface (not 0.0.0.0)
# to ensure it is not accidentally exposed to the internet.
# Access it from Windows via: http://tradingpi.local:5000
#
# Installation:
#   sudo cp services/lean-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable lean-web   # start automatically on boot
#   sudo systemctl start lean-web    # start now
#
# Management:
#   sudo systemctl status lean-web
#   sudo journalctl -u lean-web -f
# =============================================================================

[Unit]
Description=Pi-AI-Trader Flask Web Interface
Documentation=https://github.com/sdelvisco/Pi-AI-Trader

# Start after network is available (needed to bind to the network interface).
After=network-online.target
Wants=network-online.target

# The web interface can start independently of the trading engine — it
# gracefully handles the case where LEAN is not yet running.

# Limit to 5 restart attempts within a 2-minute window. If the web interface
# crashes more than 5 times in 2 minutes, systemd marks it as 'failed'.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# -------------------------------------------------------------------------
# Identity
# -------------------------------------------------------------------------
User=pi-admin
Group=pi-admin

WorkingDirectory=/home/pi-admin/Pi-AI-Trader

# -------------------------------------------------------------------------
# Credentials — notification settings for email/SMS alerts triggered via UI.
# -------------------------------------------------------------------------
EnvironmentFile=-/etc/tradingpi/alpaca.env
EnvironmentFile=-/etc/tradingpi/notifications.env

# Flask production settings.
Environment=FLASK_ENV=production
Environment=FLASK_DEBUG=0

# Secret key for Flask session signing. Generate a strong random value with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Then set it in /etc/tradingpi/web.env and reference here:
EnvironmentFile=-/etc/tradingpi/web.env

# -------------------------------------------------------------------------
# Process
# -------------------------------------------------------------------------
Type=simple

ExecStart=/home/pi-admin/Pi-AI-Trader/venv/bin/python3 -m web.app

# -------------------------------------------------------------------------
# Failure handling
# -------------------------------------------------------------------------
Restart=on-failure
RestartSec=10

# -------------------------------------------------------------------------
# Resource limits
# -------------------------------------------------------------------------
MemoryMax=256M
CPUQuota=50%

# -------------------------------------------------------------------------
# Security hardening
# -------------------------------------------------------------------------
# Note: ProtectSystem=strict is intentionally omitted. This is a local-only
# service on a dedicated trading Pi; the strict namespace sandbox causes
# exit code 226 (mount namespace failure) if expected ReadWritePaths don't
# exist at start time (e.g. lean/Results). NoNewPrivileges is sufficient.
NoNewPrivileges=true

# -------------------------------------------------------------------------
# Logging
# -------------------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lean-web

[Install]
WantedBy=multi-user.target
