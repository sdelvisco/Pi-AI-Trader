# =============================================================================
# lean-trader.service — LEAN Engine Live Trading systemd Unit
# =============================================================================
# Manages the LEAN Engine process for live algorithmic trading.
#
# Installation:
#   sudo cp services/lean-trader.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable lean-trader   # start automatically on boot
#   sudo systemctl start lean-trader    # start now
#
# Management:
#   sudo systemctl status lean-trader   # check status
#   sudo systemctl stop lean-trader     # graceful stop
#   sudo journalctl -u lean-trader -f   # follow logs
#
# SECURITY NOTE:
#   The EnvironmentFile at /etc/tradingpi/alpaca.env must be:
#     - Owned by root: sudo chown root:root /etc/tradingpi/alpaca.env
#     - Readable only by root: sudo chmod 600 /etc/tradingpi/alpaca.env
#   The service runs as the 'pi-admin' user (no Docker group required).
#   To create the environment file:
#     sudo mkdir -p /etc/tradingpi
#     sudo cp config/alpaca_credentials.template /etc/tradingpi/alpaca.env
#     sudo nano /etc/tradingpi/alpaca.env   # fill in your credentials
#     sudo chmod 600 /etc/tradingpi/alpaca.env
# =============================================================================

[Unit]
Description=Pi-AI-Trader LEAN Engine Live Trading
Documentation=https://github.com/sdelvisco/Pi-AI-Trader

# Start after the network is fully online (eth0 must have an IP for Alpaca API).
After=network-online.target
Wants=network-online.target

[Service]
# -------------------------------------------------------------------------
# Identity — run as the non-root project user, not root.
# -------------------------------------------------------------------------
User=pi-admin
Group=pi-admin

# Working directory — the LEAN engine build output directory.
WorkingDirectory=/opt/lean-engine/Launcher/bin/Release

# -------------------------------------------------------------------------
# Credentials — loaded from a root-readable environment file.
# The variables defined here (ALPACA_KEY_ID, etc.) are injected into the
# process environment and referenced by lean.json via ${VAR_NAME} syntax.
# -------------------------------------------------------------------------
EnvironmentFile=/etc/tradingpi/alpaca.env

# Additional runtime environment variables.
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_NOLOGO=1

# -------------------------------------------------------------------------
# Process management
# -------------------------------------------------------------------------

# 'simple' — systemd considers the service started when ExecStart forks.
Type=simple

# Run LEAN natively via .NET — no Docker required.
ExecStart=/usr/local/bin/dotnet /opt/lean-engine/Launcher/bin/Release/QuantConnect.Lean.Launcher.dll

# Graceful stop: send SIGTERM to allow LEAN to close open positions and
# flush state before exiting. Give it up to 5 minutes.
ExecStop=/bin/kill -TERM $MAINPID
TimeoutStopSec=300

# -------------------------------------------------------------------------
# Failure handling and restart policy
# -------------------------------------------------------------------------

# Restart the service if it exits unexpectedly (exit code != 0).
# Do NOT restart on a clean stop (e.g., manual 'systemctl stop').
Restart=on-failure

# Wait 60 seconds before attempting a restart. This prevents rapid-fire
# restart loops if LEAN crashes immediately due to a configuration error.
RestartSec=60

# Limit to 3 restart attempts within a 10-minute window. If LEAN crashes
# more than 3 times in 10 minutes, systemd marks it as 'failed' and stops
# trying — preventing runaway resource consumption or duplicate trades.
StartLimitIntervalSec=600
StartLimitBurst=3

# -------------------------------------------------------------------------
# Resource limits
# -------------------------------------------------------------------------

# Limit RAM usage. The Pi 4 has 4GB; native .NET + OS leave ~3GB for LEAN.
# Adjust based on your algorithm's memory requirements.
MemoryMax=2048M

# Limit to all available CPU cores but set a soft ceiling.
# LEAN is CPU-intensive during data processing; this allows full burst
# while preventing it from completely starving the web interface.
CPUQuota=300%

# -------------------------------------------------------------------------
# Security hardening
# -------------------------------------------------------------------------

# Prevent the service from gaining new privileges.
NoNewPrivileges=true

# Restrict write access to the filesystem — allow only necessary paths.
ProtectSystem=strict
ReadWritePaths=/opt/lean-engine/Launcher/bin/Release
ReadWritePaths=/tmp

# -------------------------------------------------------------------------
# Logging
# -------------------------------------------------------------------------

# Log stdout and stderr to the systemd journal.
# View with: journalctl -u lean-trader -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lean-trader

[Install]
# Start this service when the system reaches multi-user mode (normal boot).
WantedBy=multi-user.target
